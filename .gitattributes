* text=auto eol=lf

# Batch files must keep CRLF. cmd.exe mis-parses LF-only .cmd/.bat in ways that
# only show up at runtime (notably around labels and multi-line blocks), so the
# repo-wide eol=lf above must not apply to them.
*.cmd text eol=crlf
*.bat text eol=crlf

# The published CSV export is a DOWNLOAD, so the bytes served have to be the
# bytes generated. The repo-wide eol=lf above was rewriting its CRLF line
# endings to LF, which RFC 4180 does not permit and which some spreadsheet and
# GIS importers still trip over. -text disables normalisation entirely, so the
# BOM and the CRLF both survive the round trip through git and GitHub Pages.
data/exports/*.csv -text

*.xlsx binary
*.xls  binary
*.docx binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.zip  binary
*.kmz  binary
